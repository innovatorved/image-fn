{
  "name": "image-fn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-region Azure-ready Bun.Image transform server with lightweight UI",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:azure": "bun src/index.ts",
    "storage:init": "bun src/scripts/init-storage.ts",
    "probe:health": "bun src/scripts/probe-health.ts",
    "docker:build": "docker build -t image-fn .",
    "docker:run": "docker run --rm -p 8787:8787 --env-file .env image-fn",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun run src/lib/transform.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
