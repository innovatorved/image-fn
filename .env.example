# Bun server
PORT=8787
BIND_ADDRESS=0.0.0.0
ENVIRONMENT=development
CORS_ORIGIN=*
ALLOWED_HOST_SUFFIXES=*
CACHE_TTL_SECONDS=3600
# Source image decode budget shared by /i and /api/transform.
# 268435456 px (~256 MP) comfortably covers a 25 MB photo (e.g. 5000x5000).
MAX_IMAGE_PIXELS=268435456
MAX_OUTPUT_PIXELS=41943040
# Max source bytes accepted from an upload or a remote URL (26214400 = 25 MiB).
MAX_SOURCE_BYTES=26214400
MAX_CACHE_BYTES=134217728
SOURCE_FETCH_TIMEOUT_MS=10000

# ==== Azure multi-region storage ====

# Azure region this instance runs in (eastus | westus2 | northeurope | local)
AZURE_REGION=eastus

# Primary Azure Storage Account (East US - RA-GRS).
# On Azure VMs with a System-Assigned Managed Identity, NO keys or connection
# strings are needed: DefaultAzureCredential picks up the VM identity and reads
# automatically fail over to `<account>-secondary.blob.core.windows.net`.
AZURE_STORAGE_ACCOUNT_NAME=stimagefnprod01

# Optional: local regional read-replica Storage Account (Object Replication).
# Set to stimagefneurep01 on the North Europe VMs so EU compute reads locally
# before falling back to the primary account. Uses Managed Identity unless a
# replica connection string is provided below.
AZURE_REPLICA_STORAGE_ACCOUNT_NAME=

# Blob container names
AZURE_RAW_CONTAINER=raw-images
AZURE_CACHE_CONTAINER=processed-cache

# Connection string (access key) fallback for labs / subscriptions without
# Managed Identity permission. WHEN SET IT TAKES PRECEDENCE: src/storage.ts
# builds the client from this string and never constructs DefaultAzureCredential.
# Grab it from: Storage account -> Security + networking -> Access keys.
# Leave empty in production on Azure VMs that use Managed Identity.
AZURE_STORAGE_CONNECTION_STRING=

# Optional access-key string for the region-local read replica. When set it
# takes precedence over Managed Identity for the replica client.
AZURE_REPLICA_STORAGE_CONNECTION_STRING=

# Max time (ms) to wait for container bootstrap before serving anyway (default 7500).
AZURE_STORAGE_INIT_TIMEOUT_MS=7500
